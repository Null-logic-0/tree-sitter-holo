{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "holo",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "doctype"
        },
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "script_element"
        },
        {
          "type": "SYMBOL",
          "name": "style_element"
        },
        {
          "type": "SYMBOL",
          "name": "element"
        },
        {
          "type": "SYMBOL",
          "name": "void_element"
        },
        {
          "type": "SYMBOL",
          "name": "if_block"
        },
        {
          "type": "SYMBOL",
          "name": "for_block"
        },
        {
          "type": "SYMBOL",
          "name": "raw_block"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "escape_sequence"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "doctype": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "<![Dd][Oo][Cc][Tt][Yy][Pp][Ee]"
        },
        {
          "type": "PATTERN",
          "value": "[^>]+"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<!--"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              },
              {
                "type": "SYMBOL",
                "name": "comment_text"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "-->"
        }
      ]
    },
    "comment_text": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^-{\\\\]+"
          },
          {
            "type": "PATTERN",
            "value": "-"
          }
        ]
      }
    },
    "element": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "start_tag"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_node"
              }
            },
            {
              "type": "SYMBOL",
              "name": "end_tag"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "self_closing_tag"
        }
      ]
    },
    "void_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "area"
              },
              {
                "type": "STRING",
                "value": "base"
              },
              {
                "type": "STRING",
                "value": "br"
              },
              {
                "type": "STRING",
                "value": "col"
              },
              {
                "type": "STRING",
                "value": "embed"
              },
              {
                "type": "STRING",
                "value": "hr"
              },
              {
                "type": "STRING",
                "value": "img"
              },
              {
                "type": "STRING",
                "value": "input"
              },
              {
                "type": "STRING",
                "value": "link"
              },
              {
                "type": "STRING",
                "value": "meta"
              },
              {
                "type": "STRING",
                "value": "param"
              },
              {
                "type": "STRING",
                "value": "source"
              },
              {
                "type": "STRING",
                "value": "track"
              },
              {
                "type": "STRING",
                "value": "wbr"
              },
              {
                "type": "STRING",
                "value": "slot"
              },
              {
                "type": "STRING",
                "value": "window"
              },
              {
                "type": "STRING",
                "value": "document"
              }
            ]
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_like"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": ">"
            },
            {
              "type": "STRING",
              "value": "/>"
            }
          ]
        }
      ]
    },
    "start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_like"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "self_closing_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_like"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "SYMBOL",
          "name": "_tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "_tag_name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag_name"
        },
        {
          "type": "SYMBOL",
          "name": "component_name"
        },
        {
          "type": "SYMBOL",
          "name": "dynamic_tag_name"
        }
      ]
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "[a-z][a-zA-Z0-9_\\-.:]*"
    },
    "component_name": {
      "type": "PATTERN",
      "value": "[A-Z][a-zA-Z0-9_]*(\\.[A-Z][a-zA-Z0-9_]*)*"
    },
    "dynamic_tag_name": {
      "type": "SYMBOL",
      "name": "expression"
    },
    "if_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "if_open"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "else_branch"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "if_close"
        }
      ]
    },
    "else_branch": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "else_directive"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        }
      ]
    },
    "if_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{%if"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expression_value"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "else_directive": {
      "type": "STRING",
      "value": "{%else}"
    },
    "if_close": {
      "type": "STRING",
      "value": "{/if}"
    },
    "for_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "for_open"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_node"
          }
        },
        {
          "type": "SYMBOL",
          "name": "for_close"
        }
      ]
    },
    "for_open": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{%for"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expression_value"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "for_close": {
      "type": "STRING",
      "value": "{/for}"
    },
    "raw_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "raw_open"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "raw_text"
          }
        },
        {
          "type": "SYMBOL",
          "name": "raw_close"
        }
      ]
    },
    "raw_open": {
      "type": "STRING",
      "value": "{%raw}"
    },
    "raw_close": {
      "type": "STRING",
      "value": "{/raw}"
    },
    "raw_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^{]+"
            },
            {
              "type": "PATTERN",
              "value": "\\{"
            }
          ]
        }
      }
    },
    "script_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_script_start_tag"
          },
          "named": true,
          "value": "start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "SYMBOL",
                "name": "embedded_text"
              }
            ]
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_script_end_tag"
          },
          "named": true,
          "value": "end_tag"
        }
      ]
    },
    "style_element": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_style_start_tag"
          },
          "named": true,
          "value": "start_tag"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "SYMBOL",
                "name": "embedded_text"
              }
            ]
          }
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "SYMBOL",
            "name": "_style_end_tag"
          },
          "named": true,
          "value": "end_tag"
        }
      ]
    },
    "_script_start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "script"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_like"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "_script_end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "script"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "_style_start_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "style"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_attribute_like"
          }
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "_style_end_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "style"
          },
          "named": true,
          "value": "tag_name"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "embedded_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[^<{$]+"
            },
            {
              "type": "PATTERN",
              "value": "<"
            },
            {
              "type": "PATTERN",
              "value": "\\$\\{"
            },
            {
              "type": "PATTERN",
              "value": "\\$"
            }
          ]
        }
      }
    },
    "_attribute_like": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute"
        },
        {
          "type": "SYMBOL",
          "name": "event_attribute"
        },
        {
          "type": "SYMBOL",
          "name": "spread"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "attribute_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "SYMBOL",
                  "name": "_attribute_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "event_attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "event_name"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "SYMBOL",
                  "name": "_attribute_value"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "spread": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "..."
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[^\\s#$%=\"'`{}<>\\/\\\\.][^\\s#$%=\"'`{}<>\\/\\\\]*"
    },
    "event_name": {
      "type": "PATTERN",
      "value": "\\$[^\\s#$%=\"'`{}<>\\/\\\\]+"
    },
    "_attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_attribute_value"
        }
      ]
    },
    "quoted_attribute_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "expression"
              },
              {
                "type": "SYMBOL",
                "name": "escape_sequence"
              },
              {
                "type": "SYMBOL",
                "name": "attribute_text"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "attribute_text": {
      "type": "PATTERN",
      "value": "[^\"{\\\\]+"
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "expression_value"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expression_value": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_expression_chunk"
      }
    },
    "_expression_chunk": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^{}\"']+"
        },
        {
          "type": "SYMBOL",
          "name": "_elixir_string"
        },
        {
          "type": "SYMBOL",
          "name": "_elixir_charlist"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "{"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_expression_chunk"
              }
            },
            {
              "type": "STRING",
              "value": "}"
            }
          ]
        }
      ]
    },
    "_elixir_string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\"\\\\#]+"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[\\s\\S]"
              },
              {
                "type": "STRING",
                "value": "#"
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "#{"
                  },
                  {
                    "type": "REPEAT",
                    "content": {
                      "type": "SYMBOL",
                      "name": "_expression_chunk"
                    }
                  },
                  {
                    "type": "STRING",
                    "value": "}"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "_elixir_charlist": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^'\\\\]+"
              },
              {
                "type": "PATTERN",
                "value": "\\\\[\\s\\S]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "'"
        }
      ]
    },
    "escape_sequence": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\\\[{}#$\"'`\\\\]"
      }
    },
    "text": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^<{\\\\\\s]([^<{\\\\]*[^<{\\\\\\s])?"
          },
          {
            "type": "PATTERN",
            "value": "\\\\"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}